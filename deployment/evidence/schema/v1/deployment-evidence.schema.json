{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Conxian/Conxian/blob/main/deployment/evidence/schema/v1/deployment-evidence.schema.json",
  "title": "Conxian Deployment Evidence Manifest v1",
  "description": "A bounded, fail-closed manifest of confirmed Stacks deployment evidence. Plans, workflow success, and broadcast-only IDs are not evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "network",
    "apiBaseUrl",
    "deployer",
    "evidence",
    "contracts"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "network": {
      "enum": [
        "testnet",
        "mainnet"
      ]
    },
    "apiBaseUrl": {
      "enum": [
        "https://api.testnet.hiro.so",
        "https://api.mainnet.hiro.so"
      ]
    },
    "deployer": {
      "type": "string",
      "pattern": "^S[TP][0-9A-Z]{39}$"
    },
    "evidence": {
      "$ref": "#/$defs/evidenceMetadata"
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/contractEvidence"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "network": {
            "const": "testnet"
          }
        }
      },
      "then": {
        "properties": {
          "deployer": {
            "pattern": "^ST[0-9A-Z]{39}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "network": {
            "const": "mainnet"
          }
        }
      },
      "then": {
        "properties": {
          "deployer": {
            "pattern": "^SP[0-9A-Z]{39}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "network": {
            "const": "testnet"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "planPath": {
                "const": "deployments/full-system.testnet-plan.yaml"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "network": {
            "const": "mainnet"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "planPath": {
                "const": "deployments/full-system.mainnet-plan.yaml"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "contractName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,127}$"
    },
    "clarityHex": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]+$"
    },
    "address": {
      "type": "string",
      "pattern": "^S[TP][0-9A-Z]{39}$"
    },
    "contractPrincipal": {
      "type": "string",
      "pattern": "^S[TP][0-9A-Z]{39}\\.[a-z][a-z0-9-]{0,127}$"
    },
    "txId": {
      "type": "string",
      "pattern": "^(0x)?[0-9a-fA-F]{64}$"
    },
    "evidenceMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "capturedAt",
        "gitCommit",
        "planPath",
        "planSha256"
      ],
      "properties": {
        "source": {
          "const": "confirmed-receipts"
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "gitCommit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "planPath": {
          "type": "string",
          "minLength": 1,
          "description": "The canonical deployment plan path for the selected network."
        },
        "planSha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "interfaceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "expectedContractName"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "expectedContractName": {
          "$ref": "#/$defs/contractName"
        },
        "expectedFunctions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contractName"
          },
          "uniqueItems": true
        }
      }
    },
    "readOnlyCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "function",
        "sender",
        "arguments",
        "expectedResultHex"
      ],
      "properties": {
        "function": {
          "$ref": "#/$defs/contractName"
        },
        "sender": {
          "$ref": "#/$defs/address"
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clarityHex"
          }
        },
        "expectedResultHex": {
          "$ref": "#/$defs/clarityHex"
        }
      }
    },
    "contractEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "principal",
        "publishTxId",
        "interface"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/contractName"
        },
        "principal": {
          "$ref": "#/$defs/contractPrincipal"
        },
        "publishTxId": {
          "$ref": "#/$defs/txId"
        },
        "interface": {
          "$ref": "#/$defs/interfaceEvidence"
        },
        "readOnlyChecks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/readOnlyCheck"
          }
        }
      }
    }
  }
}
