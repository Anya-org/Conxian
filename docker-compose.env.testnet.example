# Environment variables for the root docker-compose reference stack (testnet lane).
#
# Copy this file to `.env` (never commit `.env`):
#
#   cp docker-compose.env.testnet.example .env
#

# Shared
DB_USER=postgres
DB_PASSWORD=
DB_NAME=nexus

# Nexus
STACKS_NODE_RPC_URL=https://api.testnet.hiro.so
NEXUS_EXPERIMENTAL_APIS=0
NEXUS_ORACLE_ENABLED=0
NEXUS_ORACLE_STUB_OK=0

# Gateway
BITCOIN_RPC_URL=https://bitcoin-testnet-rpc.publicnode.com
STACKS_RPC_URL=https://api.testnet.hiro.so

API_TOKEN=
FIAT_WEBHOOK_SECRET=
SETTLEMENT_INGRESS_SECRET=
HMAC_SECRET=

RAMP_API_KEY=
INVESTEC_CLIENT_ID=dev-investec-client-id
INVESTEC_SECRET=
ALCHEMY_PAY_APP_ID=dev-alchemy-pay-app-id
ALCHEMY_PAY_SECRET=
BANXA_API_KEY=
BANXA_SECRET=
INFOBIP_API_KEY=
