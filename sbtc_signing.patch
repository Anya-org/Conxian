/**
 * Signs an sBTC Peg-In request within the StrongBox TEE.
 */
export const signSbtcPegIn = async (
    bitcoinTx: string,
    outputIndex: number,
    stacksAddress: string,
    seed?: Uint8Array
): Promise<string> => {
    const result = await requestEnclaveSignature({
        type: 'transaction',
        layer: 'Mainnet',
        payload: { bitcoinTx, outputIndex, stacksAddress },
        description: 'Authorize sBTC Peg-In'
    }, seed);
    return result.signature;
};

/**
 * Signs an sBTC Peg-Out request within the StrongBox TEE.
 */
export const signSbtcPegOut = async (
    amountSats: number,
    bitcoinAddress: string,
    seed?: Uint8Array
): Promise<string> => {
    const result = await requestEnclaveSignature({
        type: 'transaction',
        layer: 'Stacks',
        payload: { amountSats, bitcoinAddress },
        description: 'Authorize sBTC Peg-Out'
    }, seed);
    return result.signature;
};

