{
  "name": "conxian-protocol",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "description": "Conxian Finance Protocol - Sovereign Autonomous Business (SAB) on Stacks",
  "scripts": {
    "preinstall": "npx npm-force-resolutions",
    "test": "bash scripts/run-tests.sh",
    "clarinet:check": "clarinet check",
    "check": "clarinet check",
    "clarinet:console": "clarinet console",
    "validate:docs": "node ./scripts/validate-docs.js",
    "test:docs-validation": "node --test tests/validate-docs.test.js",
    "verify:knowledge-base": "python3 scripts/verify-knowledge-base.py --check",
    "update:knowledge-base": "python3 scripts/verify-knowledge-base.py --write",
    "test:knowledge-base": "python3 -m unittest tests/test_verify_knowledge_base.py",
    "validate:deployment-plans": "python3 scripts/gen-deployment-plans.py --check",
    "verify:zkml-quarantine": "uv run --no-project --with 'PyYAML==6.0.2' python3 scripts/verify_zkml_quarantine.py",
    "test:zkml-quarantine": "uv run --no-project --with 'PyYAML==6.0.2' python3 -m unittest tests/test_verify_zkml_quarantine.py",
    "verify:proof-of-reserves-boundary": "python3 scripts/verify_proof_of_reserves_boundary.py",
    "test:proof-of-reserves-boundary": "python3 -m unittest tests/test_verify_proof_of_reserves_boundary.py",
    "assert:community-voting-wiring": "python3 scripts/assert-community-voting-wiring.py",
    "ci": "bash scripts/run-tests.sh",
    "coverage": "vitest run --coverage",
    "derive:wallets": "tsx scripts/derive_wallets.ts",
    "validate:deployment-plan": "ruby scripts/validate-deployment-plan.rb",
    "verify:deployment-evidence": "tsx scripts/deployment/verify-evidence.ts",
    "verify:sbtc-phase2": "tsx scripts/sbtc-phase2/verify-evidence.ts",
    "test:sbtc-phase2": "vitest run --config vitest.sbtc-phase2.config.ts",
    "test:deployment-evidence": "node scripts/test-deployment-evidence.mjs",
    "test:release-plan-validation": "python3 -m unittest tests/test_release_plan_validation.py"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@stacks/wallet-sdk": "^7.6.0",
    "bignumber.js": "^11.1.5",
    "buffer": "^6.0.3",
    "ecpair": "^3.0.1",
    "elliptic": "^6.6.1",
    "generator-function": "^2.0.1",
    "is-generator-function": "^1.1.2",
    "js-sha256": "^1.0.0",
    "light-bolt11-decoder": "^3.2.0",
    "mime-db": "^1.52.0",
    "node-fetch": "^3.3.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@stacks/blockchain-api-client": "^9.0.2",
    "@stacks/clarinet-sdk": "^3.23.1",
    "@stacks/common": "^7.3.1",
    "@stacks/network": "^7.3.1",
    "@stacks/stacking": "^7.6.0",
    "@stacks/transactions": "^7.5.0",
    "@testing-library/react": "^16.3.2",
    "@types/cors": "^2.8.19",
    "@types/elliptic": "^6.4.18",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@types/xml2js": "^0.4.14",
    "@vitest/coverage-v8": "^4.1.11",
    "bech32": "^2.0.0",
    "bip32": "^5.0.1",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^7.0.1",
    "bs58": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "npm-force-resolutions": "^0.0.10",
    "supertest": "^7.2.2",
    "tiny-secp256k1": "^2.2.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9",
    "xml2js": "^0.6.2",
    "yaml": "2.9.0",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/api": "1.9.1"
    }
  },
  "license": "GPL-3.0"
}
