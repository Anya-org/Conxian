# Environment variables for the root docker-compose reference stack (mainnet lane).
#
# Uses public mainnet RPCs. No local node required.
#
# Copy this file to `.env` (never commit `.env`):
#
#   cp docker-compose.env.mainnet.example .env
#
# For RPC options see docker-compose.env.example (the comprehensive reference).

# Shared
DB_USER=postgres
DB_PASSWORD=
DB_NAME=nexus

# Nexus (Stacks mainnet - Hiro public API)
STACKS_NODE_RPC_URL=https://api.mainnet.hiro.so
NEXUS_EXPERIMENTAL_APIS=0
NEXUS_ORACLE_ENABLED=0
NEXUS_ORACLE_STUB_OK=0

# Gateway (Bitcoin mainnet + Stacks mainnet - public RPCs)
BITCOIN_RPC_URL=https://bitcoin-rpc.publicnode.com
BITCOIN_RPC_USER=
BITCOIN_RPC_PASS=
STACKS_RPC_URL=https://api.mainnet.hiro.so

API_TOKEN=
FIAT_WEBHOOK_SECRET=
SETTLEMENT_INGRESS_SECRET=
HMAC_SECRET=

RAMP_API_KEY=
INVESTEC_CLIENT_ID=dev-investec-client-id
INVESTEC_SECRET=
ALCHEMY_PAY_APP_ID=dev-alchemy-pay-app-id
ALCHEMY_PAY_SECRET=
BANXA_API_KEY=
BANXA_SECRET=
INFOBIP_API_KEY=
