# Conxian Protocol - Environment Variables Template
# Copy this file to .env (and/or ui/.env.local) and fill in your details.
# Never commit real secrets.

# The private key for the deployer/admin account (KEEP SECRET)
DEPLOYER_PRIVKEY=

# The Stacks address associated with the system/deployer
SYSTEM_ADDRESS=

# Network selection: testnet, mainnet, or mocknet
NETWORK=testnet

# The Stacks Node API URL
CORE_API_URL=https://api.testnet.hiro.so

# Hiro API key (required to run tests/hiro-api.test.ts; optional for normal usage)
HIRO_API_KEY=

# Optional: UI Core API URL override (Next.js public env)
NEXT_PUBLIC_CORE_API_URL=
