# Environment variables for the Conxian docker-compose reference stack.
#
# This file (docker-compose.env.example) is the MAINNET lane alias and the
# comprehensive reference for all RPC/node configuration options.
#
# Usage:
#
#   cp docker-compose.env.example .env              # Mainnet (public RPCs)
#   cp docker-compose.env.testnet.example .env       # Testnet (public RPCs)
#   cp docker-compose.env.local.example .env         # Local dev (mock nodes)
#
# ─── RPC / NODE CONFIGURATION GUIDE ───────────────────────────────────────────
#
# You can use ANY combination of backends. Mix and match per network:
#
#   Public RPCs (default - no local node required):
#     Stacks:  https://api.mainnet.hiro.so          (Hiro public API)
#              https://api.testnet.hiro.so            (Hiro testnet API)
#     Bitcoin: https://bitcoin-rpc.publicnode.com    (publicnode.com)
#              https://bitcoin-testnet-rpc.publicnode.com
#
#   Your Own Node (local machine):
#     Stacks:  http://localhost:20443                (stacks-node RPC)
#              http://localhost:3999                  (mocknet/simnet)
#     Bitcoin: http://localhost:8332                  (bitcoind mainnet)
#              http://localhost:18443                  (bitcoind regtest)
#              http://localhost:18332                  (bitcoind testnet)
#
#   Docker / Docker Compose (sibling containers):
#     Stacks:  http://stacks-node:20443
#     Bitcoin: http://bitcoin-node:8332
#
#   Kubernetes:
#     Stacks:  http://stacks-node-service.namespace.svc.cluster.local:20443
#     Bitcoin: http://bitcoin-node-service.namespace.svc.cluster.local:8332
#
#   Cloud / Managed:
#     Stacks:  https://your-stacks-node.cloud-provider.com
#     Bitcoin: https://your-bitcoin-node.cloud-provider.com:8332
#              (with wss:// for websocket support)
#
#   Docker host.docker.internal (host networking bridge):
#     Stacks:  http://host.docker.internal:20443
#     Bitcoin: http://host.docker.internal:8332
#

# Shared
DB_USER=postgres
DB_PASSWORD=
DB_NAME=nexus

# ─── Nexus (Blockchain Indexer / API Layer) ──────────────────────────────────
# STACKS_NODE_RPC_URL: Stacks blockchain node endpoint.
#   Public: https://api.mainnet.hiro.so | https://api.testnet.hiro.so
#   Local:  http://localhost:20443 | http://host.docker.internal:3999
#   K8s:    http://stacks-node-service:20443
STACKS_NODE_RPC_URL=https://api.mainnet.hiro.so
NEXUS_EXPERIMENTAL_APIS=0
NEXUS_ORACLE_ENABLED=0
NEXUS_ORACLE_STUB_OK=0

# ─── Gateway (Sovereign Compliance & Settlement Pipe) ────────────────────
# BITCOIN_RPC_URL: Bitcoin JSON-RPC endpoint.
#   Public: https://bitcoin-rpc.publicnode.com
#   Local:  http://localhost:8332 | http://host.docker.internal:18443
#   K8s:    http://bitcoin-node-service:8332
# BITCOIN_RPC_USER / BITCOIN_RPC_PASS: Required for authenticated RPC nodes
#   (e.g. local bitcoind). Leave empty for public RPCs.
BITCOIN_RPC_URL=https://bitcoin-rpc.publicnode.com
BITCOIN_RPC_USER=
BITCOIN_RPC_PASS=

# STACKS_RPC_URL: Stacks RPC endpoint for gateway operations.
#   Same patterns as STACKS_NODE_RPC_URL above.
STACKS_RPC_URL=https://api.mainnet.hiro.so

# ─── FIAT / Payment Integrations ─────────────────────────────────────────────
# Set these for production. Leave empty for dev/stub mode.
API_TOKEN=
FIAT_WEBHOOK_SECRET=
SETTLEMENT_INGRESS_SECRET=
HMAC_SECRET=

RAMP_API_KEY=
INVESTEC_CLIENT_ID=dev-investec-client-id
INVESTEC_SECRET=
ALCHEMY_PAY_APP_ID=dev-alchemy-pay-app-id
ALCHEMY_PAY_SECRET=
BANXA_API_KEY=
BANXA_SECRET=
INFOBIP_API_KEY=
