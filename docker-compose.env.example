# Environment variables for the root docker-compose reference stack.
#
# Copy this file to `.env` (never commit `.env`):
#
#   cp docker-compose.env.example .env
#

# Shared
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nexus

# Nexus
STACKS_NODE_RPC_URL=https://api.mainnet.hiro.so

# Gateway
BITCOIN_RPC_URL=https://bitcoin-rpc.publicnode.com
STACKS_RPC_URL=https://api.mainnet.hiro.so

API_TOKEN=dev-api-token
FIAT_WEBHOOK_SECRET=dev-fiat-webhook-secret
SETTLEMENT_INGRESS_SECRET=dev-settlement-ingress-secret
HMAC_SECRET=dev-hmac-secret

RAMP_API_KEY=dev-ramp-api-key
INVESTEC_CLIENT_ID=dev-investec-client-id
INVESTEC_SECRET=dev-investec-secret
ALCHEMY_PAY_APP_ID=dev-alchemy-pay-app-id
ALCHEMY_PAY_SECRET=dev-alchemy-pay-secret
BANXA_API_KEY=dev-banxa-api-key
BANXA_SECRET=dev-banxa-secret
INFOBIP_API_KEY=dev-infobip-api-key
