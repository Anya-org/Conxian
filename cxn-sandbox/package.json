{
  "name": "@conxian/sandbox",
  "version": "0.1.0",
  "description": "Conxian Developer Sandbox - Sovereign Bitcoin Infrastructure",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "docker-compose up",
    "dev:gateway": "docker-compose up gateway",
    "dev:all": "docker-compose up",
    "build": "tsc",
    "clean": "docker-compose down -v",
    
    "example:hello-world": "tsx examples/quickstart/01-hello-world.ts",
    "example:payment": "tsx examples/payments/iso20022-payment.ts",
    "example:settlement": "tsx examples/payments/bitcoin-settlement.ts",
    "example:lightning": "tsx examples/payments/lightning-payment.ts",
    "example:enclave": "tsx examples/security/enclave-attestation.ts",
    "example:all": "npm run example:hello-world && npm run example:payment"
  },
  "dependencies": {
    "@conxian/sdk": "workspace:*",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "docker": ">=24.0.0"
  },
  "keywords": [
    "bitcoin",
    "stacks",
    "iso20022",
    "payments",
    "fintech",
    "sovereign"
  ],
  "author": "Conxian Labs",
  "license": "MIT"
}
