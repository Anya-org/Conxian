# Conxian Sandbox Environment Variables
# Copy this file to .env and fill in values

# PostgreSQL Configuration
POSTGRES_DB=conxian
POSTGRES_USER=conxian
POSTGRES_PASSWORD=your-secure-password-here

# Redis Configuration
REDIS_URL=redis://redis:6379

# Optional: Bitcoin RPC (for gateway)
# BITCOIN_RPC_URL=https://bitcoin-testnet.publicnode.com
